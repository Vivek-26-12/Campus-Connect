      ]
    },
    {
      "name": "5. Centralized Error Handling & Isolation",
      "item": [
        {
          "name": "Unreachable Service 502 Bad Gateway Test",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "description": "Execute after running 'docker stop user-service'. Confirms Gateway intercepts ECONNREFUSED and responds with HTTP 502 Bad Gateway and clean JSON diagnostic."
          }
        },
        {
          "name": "Gateway 404 Unmapped Route Test",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v2/unregistered",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v2", "unregistered"]
            },
            "description": "Tests centralized 404 response for endpoints not registered in the Gateway routing table."
          }
        },
        {
          "name": "Port Isolation Proof (Direct Call to :3001)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3001/users",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["users"]
            },
            "description": "Proves network isolation: direct access to User Service on port 3001 fails because only port 3000 is published."
          }
        }
      ]
    }
  ]
}
