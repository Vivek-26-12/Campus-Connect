{
  "info": {
    "_postman_id": "b7c8d9e0-f1a2-3456-bcde-fa1234567890",
    "name": "Lab 7: API Gateway, Service Discovery & Cloud Deployment",
    "description": "Postman Test Suite for CampusConnect API Gateway (Lab 7) - Web Services & SOA Laboratory.\nSingle entry point routing to User, Product, and Order services with centralized error handling, configuration-based service discovery, and cloud deployment verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string",
      "description": "Base URL of the API Gateway (Local: http://localhost:3000, Cloud: https://campusconnect-gateway.onrender.com)"
    }
  ],
  "item": [
    {
      "name": "1. Gateway Core & Service Discovery",
      "item": [
        {
          "name": "GET /health (Gateway Health Check)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Gateway health-check endpoint reporting gateway status 'UP', uptime, and active service discovery registry table."
          }
        },
        {
          "name": "GET /services (Dynamic Service Registry)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/services",
              "host": ["{{baseUrl}}"],
              "path": ["services"]
            },
            "description": "Returns the configuration-driven service registry URLs loaded at startup."
          }
        },
        {
          "name": "GET / (Gateway Status Dashboard)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "API Gateway landing documentation with routing tables and service targets."
          }
        }
      ]
    },
    {
      "name": "2. User Service via Gateway (/users)",
      "item": [
        {
          "name": "GET All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "description": "Gateway routes /users to User Service. Returns 200 OK with list of users."
          }
        },
        {
          "name": "GET User by ID (101)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/101",
              "host": ["{{baseUrl}}"],
              "path": ["users", "101"]
            },
            "description": "Gateway routes /users/101 to User Service. Returns Aarav Patel."
          }
        },
        {
          "name": "POST Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vikram Malhotra\",\n  \"email\": \"vikram@campus.edu\",\n  \"department\": \"Artificial Intelligence\",\n  \"role\": \"Student\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "description": "Gateway proxies POST request with body to User Service. Returns 201 Created."
          }
        },
        {
          "name": "GET User Not Found (9999)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/9999",
              "host": ["{{baseUrl}}"],
              "path": ["users", "9999"]
            },
            "description": "Tests 404 Not Found propagation through the Gateway."
          }
        }
      ]
    },
