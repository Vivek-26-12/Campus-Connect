            },
            "url": {
              "raw": "http://localhost:3003/orders",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3003",
              "path": ["orders"]
            },
            "description": "Demonstrates successful service-to-service communication: Order -> User (101) and Order -> Product (501). Status: 201 Created"
          }
        },
        {
          "name": "GET Order by ID (1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
