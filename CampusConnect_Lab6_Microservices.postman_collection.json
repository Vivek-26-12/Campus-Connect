              "raw": "{\n  \"userId\": 101,\n  \"productId\": 501,\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "http://localhost:3003/orders",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3003",
              "path": ["orders"]
            },
            "description": "Run this after running 'docker stop user-service' to demonstrate graceful controlled failure (503 Service Unavailable)."
          }
        }
