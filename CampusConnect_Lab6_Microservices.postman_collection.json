            "description": "Test invalid user reference. Order Service calls User Service, receives 404, and returns 404 Not Found."
          }
        },
        {
          "name": "POST Order - Invalid Product ID (404 Test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 101,\n  \"productId\": 9999,\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "http://localhost:3003/orders",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3003",
              "path": ["orders"]
            },
            "description": "Test invalid product reference. Order Service calls Product Service, receives 404, and returns 404 Not Found."
          }
        },
        {
          "name": "POST Order - Dependency Failure (503 Test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
