              "port": "3003",
              "path": ["orders", "1"]
            },
            "description": "Retrieve order by ID"
          }
        },
        {
          "name": "POST Order - Invalid User ID (404 Test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 9999,\n  \"productId\": 501,\n  \"quantity\": 1\n}"
