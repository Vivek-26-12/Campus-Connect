# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string:
# e.g.: mongodb+srv://student_admin:SecretPass123@cluster0.abcde.mongodb.net/students_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://student_user:StudentPass123@cluster0.mongodb.net/students_db?retryWrites=true&w=majority

# Server Port
PORT=3000
