# =============================================================================
# CampusConnect Microservices Environment Config (Lab 7)
# API Gateway, Service Discovery & Cloud Deployment
# =============================================================================

# Public Entry Point (Only Gateway Port Exposed Externally)
GATEWAY_PORT=3000
PORT=3000

# Private Microservices Internal Ports (Internal to Docker Network)
USER_SERVICE_PORT=3001
PRODUCT_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003

# Configuration-Based Service Discovery (Dynamic Registry URLs)
# Inside Docker Network ('campus-network'):
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003

# For Local Standalone Execution (without Docker):
# USER_SERVICE_URL=http://127.0.0.1:3001
# PRODUCT_SERVICE_URL=http://127.0.0.1:3002
# ORDER_SERVICE_URL=http://127.0.0.1:3003

# Cloud Database Integration (MongoDB Atlas)
# Replace with your actual MongoDB Atlas cluster connection string:
# e.g., mongodb+srv://admin:YourPassword@cluster0.abcde.mongodb.net/campusconnect_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://campus_user:CampusPass123@cluster0.mongodb.net/campusconnect_db?retryWrites=true&w=majority

# Network Resilience & Centralized Timeout Policy
REQUEST_TIMEOUT_MS=5000
NODE_ENV=production
